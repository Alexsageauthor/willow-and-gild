{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "_comment": "REDIRECTS ARE OFF UNTIL willowandgild.com RESOLVES. They 301'd the working vercel.app host to a domain that did not exist, which took the site down. When the domain is live in Vercel and loading, restore the two redirects below and set site.js ORIGIN to match.",
  "_redirects_when_domain_is_live": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "willow-and-gild.vercel.app"
        }
      ],
      "destination": "https://willowandgild.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.willowandgild.com"
        }
      ],
      "destination": "https://willowandgild.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|xml|txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
